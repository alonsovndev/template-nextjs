{
  "name": "template-nextjs",
  "version": "0.1.0",
  "private": true,
  "description": "Production-ready Next.js + TypeScript + Ant Design template following the engineering handbook.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{src,e2e}/**/*.{ts,tsx,json,css}\" \"*.{ts,mjs,json,md}\" \"docs/**/*.md\" \".github/**/*.md\"",
    "format:check": "prettier --check \"{src,e2e}/**/*.{ts,tsx,json,css}\" \"*.{ts,mjs,json,md}\" \"docs/**/*.md\" \".github/**/*.md\"",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run --coverage",
    "test:watch": "vitest watch",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run type-check && npm run test && npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@ant-design/nextjs-registry": "^1.3.0",
    "@tanstack/react-query": "^5.104.1",
    "antd": "^6.3.2",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "jsdom": "^27.0.1",
    "lint-staged": "^16.4.0",
    "msw": "^2.13.6",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "lint-staged": {
    "{src,e2e}/**/*.{ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
